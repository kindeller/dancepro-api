APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
SANCTUM_EXPIRATION=10080
MOBILE_TOKEN_EXPIRATION=10080
MOBILE_MINIMUM_SUPPORTED_VERSION=1.0.0
MOBILE_LATEST_VERSION=1.0.0
MOBILE_MAINTENANCE=false
MOBILE_SUPPORT_URL=
MOBILE_PRIVACY_URL=
MOBILE_PUSH_GATEWAY_URL=
MOBILE_PUSH_GATEWAY_TOKEN=
API_IDEMPOTENCY_RETENTION_HOURS=24
DEPLOY_HEALTHCHECK_URL=
PUBLIC_CATALOGUE_RATE_LIMIT_PER_MINUTE=120
PUBLIC_CATALOGUE_STUDIO_LIMIT=500
PUBLIC_CATALOGUE_CONCERT_LIMIT=250
CSP_ENABLED=true
CSP_REPORT_ONLY=true

TWO_FACTOR_ENABLED=false
TWO_FACTOR_ENFORCED=false
TWO_FACTOR_ISSUER="DancePro Crew"

# Restrict this browser key to the app's web domains in Google Cloud.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

DATABASE_BACKUP_ENABLED=false
DATABASE_BACKUP_DIRECTORY=backups/database
DATABASE_BACKUP_RETENTION_DAYS=30
DATABASE_BACKUP_DUMP_BINARY=mysqldump
DATABASE_BACKUP_TIMEOUT_SECONDS=900
DATABASE_BACKUP_SCHEDULE_TIME=02:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# APP_ENV=local maps every AWS-named disk (including s3_concerts) to isolated
# private storage/app/local-aws folders. Do not use a production DB or mailer.
OPERATIONS_FILESYSTEM_DISK=local
UPLOAD_MALWARE_SCAN_ENABLED=false
UPLOAD_MALWARE_SCAN_HOST=clamav
UPLOAD_MALWARE_SCAN_PORT=3310
UPLOAD_MALWARE_SCAN_TIMEOUT_SECONDS=15
CONTACT_DIRECTORY_LOGO_DISK=public
PUBLIC_UPLOAD_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

