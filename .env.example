APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_EXPIRATION=null
STAFF_API_TOKEN_TTL_MINUTES=43200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

#AWS GENERAL
AWS_USE_PATH_STYLE_ENDPOINT=false

#AWS RELATED ENV
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_ENDPOINT=

#CONCERT AWS
AWS_CONCERT_ACCESS_KEY_ID=
AWS_CONCERT_SECRET_ACCESS_KEY=
AWS_CONCERT_DEFAULT_REGION=
AWS_CONCERT_BUCKET=
AWS_CONCERT_URL=
AWS_CONCERT_ENDPOINT=
AWS_CONCERT_USE_PATH_STYLE_ENDPOINT=false

#LEGACY CONCERT AWS
AWS_CONCERT_LEGACY_ACCESS_KEY_ID=
AWS_CONCERT_LEGACY_SECRET_ACCESS_KEY=
AWS_CONCERT_LEGACY_DEFAULT_REGION=
AWS_CONCERT_LEGACY_BUCKET=
AWS_CONCERT_LEGACY_URL=
AWS_CONCERT_LEGACY_ENDPOINT=
AWS_CONCERT_LEGACY_USE_PATH_STYLE_ENDPOINT=false

#CONCERT PLAYBACK
CONCERT_PLAYBACK_SIGNED_URL_TTL_MINUTES=15
CLOUDFRONT_CONCERT_DOMAIN=
CLOUDFRONT_CONCERT_KEY_PAIR_ID=
CLOUDFRONT_CONCERT_PRIVATE_KEY=
CLOUDFRONT_CONCERT_PRIVATE_KEY_PATH=app/private/keys/dancepro-concerts-private.pem
CLOUDFRONT_CONCERT_COOKIE_DOMAIN=
CLOUDFRONT_CONCERT_COOKIE_PATH=/
CLOUDFRONT_CONCERT_COOKIE_SECURE=true
CLOUDFRONT_CONCERT_COOKIE_SAME_SITE=lax

#CONCERT MEDIA INGEST
MEDIA_UPLOAD_DISK=s3_concerts
MEDIA_LEGACY_DISK=s3_concerts_legacy
MEDIA_UPLOAD_URL_TTL_MINUTES=15
MEDIA_UPLOAD_RECORD_TTL_HOURS=24
MEDIA_OBJECT_REF_TTL_MINUTES=15
MEDIA_MAX_FILES_PER_BATCH=100
MEDIA_MAX_SINGLE_UPLOAD_BYTES=104857600
MEDIA_MAX_BATCH_BYTES=10737418240
MEDIA_MAX_OBJECT_BYTES=107374182400
MEDIA_MULTIPART_PART_SIZE_BYTES=67108864
MEDIA_MAX_PARTS_PER_REQUEST=100
MEDIA_MAX_MANIFEST_BYTES=2097152
MEDIA_MAX_HLS_OBJECTS=10000
MEDIA_MAX_HLS_VARIANTS=4
MEDIA_LEGACY_PAGE_SIZE=100

#COMPETITIONS AWS
AWS_COMPETITIONS_ACCESS_KEY_ID=
AWS_COMPETITIONS_SECRET_ACCESS_KEY=
AWS_COMPETITIONS_DEFAULT_REGION=
AWS_COMPETITIONS_BUCKET=
AWS_COMPETITIONS_URL=
AWS_COMPETITIONS_ENDPOINT=
AWS_COMPETITIONS_USE_PATH_STYLE_ENDPOINT=false

#DOWNLOADS
DOWNLOAD_ALLOWED_DISKS=s3_competitions,s3_concerts,s3_concerts_legacy
DOWNLOAD_DEFAULT_DISK=s3_competitions
DOWNLOAD_SIGNED_URL_TTL_MINUTES=5

#TEST AWS
#AWS_TEST_BUCKET=
#AWS_TEST_URL=

VITE_APP_NAME="${APP_NAME}"
